<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme -->
    <style name="Base.Theme.MyGaragem" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/racing_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/racing_red_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/racing_red_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorSurfaceVariant">@color/dark_card</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_secondary</item>
        <item name="colorOutline">@color/dark_divider</item>
        <item name="android:colorBackground">@color/dark_surface</item>
        <item name="android:statusBarColor">@color/dark_surface</item>
        <item name="android:navigationBarColor">@color/dark_surface</item>
        <item name="android:windowBackground">@color/dark_surface</item>

        <item name="materialButtonStyle">@style/Widget.MyGaragem.Button</item>
        <item name="materialCardViewStyle">@style/Widget.MyGaragem.Card.Dark</item>
        <item name="textInputStyle">@style/Widget.MyGaragem.TextInputLayout</item>
    </style>

    <style name="Widget.MyGaragem.Card.Dark" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/dark_card</item>
        <item name="strokeColor">@color/dark_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Popup menu dark -->
    <style name="ThemeOverlay.MyGaragem.PopupMenu" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:colorBackground">@color/dark_card</item>
        <item name="android:textColor">@color/dark_text_primary</item>
    </style>
</resources>
