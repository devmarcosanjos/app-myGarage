<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.MyGaragem" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/racing_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/racing_red_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/racing_red_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/light_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/input_stroke</item>
        <item name="android:colorBackground">@color/light_surface</item>
        <item name="android:statusBarColor">@color/racing_red_dark</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/light_surface</item>

        <item name="materialButtonStyle">@style/Widget.MyGaragem.Button</item>
        <item name="materialCardViewStyle">@style/Widget.MyGaragem.Card</item>
        <item name="textInputStyle">@style/Widget.MyGaragem.TextInputLayout</item>
    </style>

    <style name="Theme.MyGaragem" parent="Base.Theme.MyGaragem" />

    <!-- Botão padrão: fundo vermelho -->
    <style name="Widget.MyGaragem.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/racing_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Botão outlined: borda vermelha -->
    <style name="Widget.MyGaragem.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/racing_red</item>
        <item name="android:textColor">@color/racing_red</item>
        <item name="cornerRadius">8dp</item>
        <item name="rippleColor">@color/racing_red_light</item>
    </style>

    <!-- TextInputLayout -->
    <style name="Widget.MyGaragem.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/racing_red</item>
        <item name="hintTextColor">@color/racing_red</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="boxStrokeErrorColor">@color/racing_red_light</item>
    </style>

    <!-- Card -->
    <style name="Widget.MyGaragem.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/light_card</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Imagem com bordas arredondadas (todas) -->
    <style name="RoundedImageShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Imagem com bordas arredondadas apenas em cima -->
    <style name="TopRoundedImageShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Popup menu -->
    <style name="ThemeOverlay.MyGaragem.PopupMenu" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:colorBackground">@color/white</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

</resources>